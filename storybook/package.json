{
  "name": "olx-design-system-storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Storybook for the OLX Design System: foundations, components and the captured page templates. Tokens and CSS come from the repo root.",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "capture:sites": "node scripts/capture-site.mjs",
    "capture:motors": "node scripts/pull-motors-html.mjs",
    "build:templates": "node scripts/build-templates.mjs",
    "build:stories": "node scripts/build-template-stories.mjs",
    "build:kit": "node scripts/build-templates.mjs && node scripts/localize-assets.mjs && node scripts/build-template-stories.mjs",
    "localize": "node scripts/localize-assets.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
